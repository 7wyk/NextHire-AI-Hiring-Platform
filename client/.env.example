# ─────────────────────────────────────────────────────────────────────────────
# Nexthire client — environment variables (Vite exposes only VITE_*)
# Copy to client/.env for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute URL of the deployed API, including /api.
# Local development: leave empty — the Vite proxy forwards /api to :5000.
# Vercel: set this in Project → Settings → Environment Variables, e.g.
#   VITE_API_URL=https://<your-render-service>.onrender.com/api
# Never point production at localhost.
VITE_API_URL=
