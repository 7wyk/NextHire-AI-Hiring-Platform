# ─────────────────────────────────────────────────────────────────────────────
# Nexthire API — environment variables
# Copy to server/.env for local development. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Atlas: mongodb+srv://<user>:<password>@<cluster>/nexthire?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexthire

# ── Authentication (REQUIRED in production) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Cookie lifetimes — keep consistent with the JWT expiries above
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── Origins (REQUIRED in production) ─────────────────────────────────────────
# Exact browser origin of the client: CORS, cookies and email links all use it.
CLIENT_URL=http://localhost:5173
# Optional extra origins, comma separated (e.g. a Vercel preview domain)
CORS_ORIGINS=
# Reverse-proxy hops in front of the app (Render = 1)
TRUST_PROXY_HOPS=1

# ── AI provider (REQUIRED for screening, interviews, assessments) ────────────
# Without a key these features return an explicit "unavailable" state; they
# never fall back to fabricated results.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Marks results as mock:true. Ignored when NODE_ENV=production.
AI_MOCK_MODE=false

# ── Code execution (OPTIONAL) ────────────────────────────────────────────────
# JavaScript always runs in the isolated local sandbox. Judge0 is required for
# Python / Java / C++ — other languages are disabled in the UI without it.
JUDGE0_API_KEY=
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# Resend (HTTP API) takes precedence; otherwise SMTP is used when configured.
# With neither, email is skipped and logged — never reported as delivered.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nexthire <no-reply@nexthire.app>
EMAIL_REPLY_TO=

# ── File storage (OPTIONAL) ──────────────────────────────────────────────────
# Cloudinary keeps uploaded resumes off Render's ephemeral disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Semantic candidate search (OPTIONAL) ─────────────────────────────────────
USE_VECTORLESS=true
PINECONE_API_KEY=
PINECONE_INDEX=

# ── Logging (OPTIONAL) ───────────────────────────────────────────────────────
LOG_LEVEL=info
# Production logs to stdout for the platform log stream. Set true only on a
# host with a persistent disk.
LOG_TO_FILE=false

# ── Rate limits (OPTIONAL overrides) ─────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=2000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_AI_MAX=60
RATE_LIMIT_RESUME_MAX=40
RATE_LIMIT_CODE_MAX=240
RATE_LIMIT_INTERVIEW_MAX=150
RATE_LIMIT_AGENT_MAX=1200
RATE_LIMIT_UPLOAD_MAX=30
